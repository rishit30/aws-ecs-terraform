// task-definition.json
{
  "family": "my-task-definition",
  "executionRoleArn": "arn:aws:iam::123456789012:role/my-ExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "my-container",
      "image": "aws_account_id.dkr.ecr.us-west-2.amazonaws.com/my-web-app:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}